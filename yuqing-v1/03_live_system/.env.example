# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# 申请地址：https://www.reddit.com/prefs/apps → create an app → 类型选 script

# Reddit 官方 API（可选，默认关闭——当前监控以国内平台为主）
# 需要海外舆情时再申请并配置：https://www.reddit.com/prefs/apps → create an app → script
REDDIT_CLIENT_ID=你的client_id
REDDIT_CLIENT_SECRET=你的client_secret
# Reddit 要求唯一 User-Agent，建议带上你的 Reddit 用户名
REDDIT_USER_AGENT=yuqing-monitor/1.0 (your_reddit_username)

# 微博（热榜公开接口无需任何密钥，默认 auto 即可采到热榜）
WEIBO_MODE=auto
# 热榜关键词：命中才保留（逗号分隔）
WEIBO_HOT_KEYWORDS=民族团结,民族,促进法,少数民族,民族地区,歧视
# 热榜话题是否计入统计（是/否）
WEIBO_HOT_COUNTED=是
# 热榜没有点赞数；=1 时用“热度值”近似填入点赞量，使话题进入大屏高热内容
WEIBO_HOT_AS_LIKES=1
# 第三方导出目录：把微博工具导出的 csv/json/jsonl 丢进去即可（默认 data/weibo_exports/）
WEIBO_EXPORT_DIR=
# 微博开放平台（可选，一般需企业资质；搜索接口还要申请高级权限）
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
WEIBO_ACCESS_TOKEN=
# 微博移动端搜索（可选，实验）：登录 m.weibo.cn 后从浏览器复制 Cookie，有风控/封号风险
WEIBO_COOKIE=

# 抖音（热榜公开接口，无需密钥）
DOUYIN_HOT_KEYWORDS=民族团结,民族,促进法,少数民族,民族地区,歧视
DOUYIN_HOT_COUNTED=是
# 热榜没有点赞数；=1 时用“热度值”近似填入点赞量
DOUYIN_HOT_AS_LIKES=1

# 微信公众号（搜狗文章搜索，无需密钥；搜狗有验证码风控，默认 10 分钟一次）
WECHAT_SOGOU_PAGES=1
WECHAT_SOGOU_INTERVAL=5

# 百度知道（公开搜索页，无需密钥；默认 10 分钟一次）
BAIDU_ZHIDAO_PAGES=1
BAIDU_ZHIDAO_INTERVAL=5

# 豆瓣（小组讨论搜索公开页，无需密钥；默认 10 分钟一次）
DOUBAN_GROUP_PAGES=1
DOUBAN_GROUP_INTERVAL=5

# 实时服务端自动调度真实平台采集器（0=关，1=开）
# 开启后：微博/抖音/B站 每 5 分钟、公众号/百度知道/豆瓣 每 10 分钟采集一次，
# 新数据入库后立即通过 SSE 推送到实时大屏（http://127.0.0.1:8765/）
LIVE_PLATFORM_ENABLED=0
LIVE_PLATFORM_POLL=10

# 可选：搜索与采集参数
LIVE_SEARCH_KEYWORDS=民族团结进步促进法,民族团结,民族歧视
LIVE_MAX_RESULTS=10
LIVE_REQUEST_INTERVAL=2
LIVE_BILIBILI_ENRICH=1
